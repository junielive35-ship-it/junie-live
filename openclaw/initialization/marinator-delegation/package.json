{
  "name": "openclaw-plugin-marinator-delegation",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:validate": "npm run build && node -e \"import('./dist/index.js').then(m=>{const e=m.default;if(!e||e.id!=='marinator-delegation'||typeof e.register!=='function') throw new Error('invalid plugin entry')})\"",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "scripts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
